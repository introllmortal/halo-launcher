<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@Launcher_AppID@</id>
  <name>Halo Launcher</name>
  <summary>Standalone Minecraft launcher to manage multiple instances, mods, and accounts</summary>
  <developer id="io.github.introllmortal">
    <name>introllmortal</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Halo Launcher is a standalone custom launcher for Minecraft focused on clean design, predictability, and ease of use.</p>
    <p>Features:</p>
    <ul>
      <li>Easily install game loaders such as NeoForge, Forge, Fabric, and Quilt</li>
      <li>Install and update modpacks and mods directly from Modrinth and CurseForge</li>
      <li>Control Java memory, JVM arguments, and per-instance settings</li>
      <li>Manage worlds, resource packs, shaders, and logs cleanly</li>
      <li>Built-in skin management and diagnostic crash reporting</li>
      <li>Isolate Minecraft instances to keep each setup clean</li>
    </ul>
  </description>
  <releases>
    <release version="@Launcher_VERSION_NAME@" date="@Launcher_BUILD_TIMESTAMP@"></release>
  </releases>
  <url type="homepage">https://github.com/introllmortal/halo-launcher</url>
  <url type="bugtracker">https://github.com/introllmortal/halo-launcher/issues</url>
  <url type="help">https://github.com/introllmortal/halo-launcher/wiki</url>
  <url type="vcs-browser">https://github.com/introllmortal/halo-launcher</url>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
  <launchable type="desktop-id">@Launcher_AppID@.desktop</launchable>
</component>
